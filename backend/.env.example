# Copy to .env and fill in. NEVER commit .env.
# Local: printed by `npm run db:start`. Hosted: Supabase dashboard > Project Settings > API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Service role key bypasses all security rules. Only used by scripts on your machine.
SUPABASE_SERVICE_ROLE_KEY=
