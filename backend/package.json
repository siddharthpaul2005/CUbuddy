{
  "name": "cubuddy-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "db:types:remote": "supabase gen types typescript --linked > types/database.ts",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs",
    "test:api": "node --env-file=.env scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "supabase": "2.121.0"
  }
}
